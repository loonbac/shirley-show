# Supply-chain hardening.
# pnpm is the only package manager for this repository.
# Refuse to run install scripts: a compromised package cannot execute code at
# install time. None of our dev dependencies need a build step.
ignore-scripts=true
# Exact versions only, so a lockfile refresh cannot silently move a dependency.
save-exact=true
# Fail if the lockfile does not match package.json (CI and local alike).
strict-peer-dependencies=false

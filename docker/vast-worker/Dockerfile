# Vast.ai GPU worker for shirley-show vocal separation.
#
# A Vast instance started from this image can separate immediately: every
# runtime dependency (ffmpeg, the PyTorch CUDA build, a pinned audio-separator)
# and every model used by BOTH separation modes is already inside the image, so
# the separation script generated by `src/infra/vocal/colab_remote_script.rs`
# runs unchanged and never touches the network.
#
# Why the models and the toolchain live in separate stages: `diffq` is a
# mandatory dependency of audio-separator with no wheel for linux, so its C
# extension has to be compiled (`gcc: not found` is what breaks
# `pip install audio-separator[cpu]` on `pytorch/pytorch:*-runtime`, which ships
# no compiler). Compiling happens in `builder`; the runtime stage keeps none of
# that toolchain, only the finished virtualenv.
#
# Base image choice: PyTorch's cu124 wheels bundle the whole CUDA runtime, so a
# slim Python base plus those wheels is several GB smaller than
# `nvidia/cuda:*-runtime`, and it still works on any host whose driver supports
# CUDA 12.4 or newer (the driver is mounted from the host, never baked in).

ARG PYTHON_VERSION=3.10

FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

ARG AUDIO_SEPARATOR_VERSION=0.48.0
ARG TORCH_VERSION=2.5.1
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
# Both models the separator can ask for: `INSTRUMENTAL_MODELS` and
# `COROS_MODELS` in src/infra/vocal/colab_vocal_separator_config.rs. They are
# passed by filename on the command line, so they must be present under these
# exact names.
ARG INSTRUMENTAL_MODEL=model_bs_roformer_ep_317_sdr_12.9755.ckpt
ARG CHORUS_MODEL=mel_band_roformer_karaoke_aufr33_viperx_sdr_10.1956.ckpt

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# diffq builds a C extension (bitpack.c) and has no linux wheel, so a C
# toolchain is required here and only here. ffmpeg is needed too because
# audio-separator refuses to start without it, including for
# `--download_model_only`, which is how the models get into the image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

RUN pip install --upgrade pip setuptools wheel \
    && pip install --index-url "${TORCH_INDEX_URL}" "torch==${TORCH_VERSION}"

# `audio-separator` only says `torch>=2.3,<3`, so without a constraint pip would
# happily replace the pinned cu124 build with a newer default-index build (it
# did: a 2.14.1+cu130 wheel, which needs a newer driver than the hosts this
# image targets). The constraint file pins it for the rest of the build.
RUN printf 'torch==%s\n' "${TORCH_VERSION}" > /tmp/torch-constraint.txt

# `[gpu]` brings onnxruntime-gpu. The RoFormer models used here run on PyTorch,
# but audio_separator imports onnxruntime unconditionally, and its CPU extra
# would make the onnx paths unusably slow on a GPU worker.
RUN pip install --constraint /tmp/torch-constraint.txt "audio-separator[gpu]==${AUDIO_SEPARATOR_VERSION}"

# Download both models with audio-separator's own resolution logic instead of
# hardcoding URLs: it knows which YAML config belongs to which checkpoint, and
# it verifies every file against its published SHA-256. `--download_model_only`
# writes the model, its config and the shared `download_checks.json` into the
# model directory, so a later load finds everything present and stays offline.
ENV AUDIO_SEPARATOR_MODEL_DIR=/opt/models
RUN mkdir -p /opt/models \
    && audio-separator \
        --download_model_only \
        --model_filename "${INSTRUMENTAL_MODEL}" \
        --extra_models "${CHORUS_MODEL}" \
        --model_file_dir /opt/models \
    && test -s "/opt/models/${INSTRUMENTAL_MODEL}" \
    && test -s "/opt/models/${CHORUS_MODEL}" \
    && test -s /opt/models/download_checks.json

# Fail the build, not a paid GPU, if the runtime imports do not work, and fail
# it if the CUDA build drifted from the pinned one: a newer wheel needs a newer
# host driver and would turn a working Vast host into a hard failure.
RUN python - <<'PY'
import os
import audio_separator
import onnxruntime
import soundfile
import torch

expected = "2.5.1"
assert torch.__version__.startswith(expected), f"torch drifted: {torch.__version__} (expected {expected})"
assert torch.version.cuda == "12.4", f"CUDA build drifted: {torch.version.cuda} (expected 12.4)"

print("audio-separator", audio_separator.__version__ if hasattr(audio_separator, "__version__") else "ok")
print("torch", torch.__version__, "cuda build", torch.version.cuda)
print("onnxruntime", onnxruntime.__version__)
print("soundfile", soundfile.__version__)
PY


FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# ffmpeg/ffprobe: the separation script encodes the averaged stem to MP3 320k
# and probes its duration with ffprobe. `apt-get install ffmpeg` costs 220-480s
# on a fresh Vast instance, which is exactly the wait this image removes.
# libsndfile1 and libsamplerate0 are the native libraries of the `soundfile` and
# `samplerate` Python packages the separator imports.
# openssh-server + ca-certificates: Vast's SSH launch mode needs an sshd in the
# image (`docs/vast-worker.md`); having it here means the instance is reachable
# without Vast's setup having to apt-install anything first.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        libsamplerate0 \
        openssh-server \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/models /opt/models

ENV PATH=/opt/venv/bin:$PATH \
    AUDIO_SEPARATOR_MODEL_DIR=/opt/models \
    # Keeps BLAS from oversubscribing the host's cores, which on a shared Vast
    # machine costs more wall time than it saves.
    OMP_NUM_THREADS=4

# Vast's SSH launch mode replaces the image entrypoint and starts sshd from its
# own setup script, so the image's ENV is not guaranteed to reach an SSH
# session. Three belt-and-braces paths make everything resolve anyway:
#   * /etc/environment is read by PAM for every login session, and is what Vast
#     itself tells custom images to write their env into.
#   * A login shell (what SSH and `bash -lc` start) sources /etc/profile, which
#     RESETS PATH and drops the venv, so profile.d re-adds it. Without this the
#     generated script's `import audio_separator` fails and it falls back to its
#     own `pip install`, which is exactly the failure this image exists to avoid.
#   * audio-separator's own `--model_file_dir` default is
#     /tmp/audio-separator-models, so pointing that path at the baked-in models
#     keeps the generated script working even with no environment at all.
# The generated script passes only `--model_filename`, both modes rely on this.
RUN printf 'AUDIO_SEPARATOR_MODEL_DIR=/opt/models\nPATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin\n' \
        > /etc/environment \
    && printf 'export PATH=/opt/venv/bin:$PATH\nexport AUDIO_SEPARATOR_MODEL_DIR=/opt/models\n' \
        > /etc/profile.d/venv.sh \
    && chmod 0644 /etc/profile.d/venv.sh \
    && ln -sfn /opt/models /tmp/audio-separator-models \
    && mkdir -p /run/sshd

# The generated script hardcodes /content for both the uploaded input
# (`/content/input_audio`) and its work directory (`/content/colab_sep_work`),
# so the path must exist in the image.
RUN mkdir -p /content/colab_sep_work

WORKDIR /content

# Vast instances of this image are driven over SSH; nothing has to listen.
CMD ["sleep", "infinity"]

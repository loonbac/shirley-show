{
  "name": "shirley-show",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de gestión de eventos musicales (frontend React; backend en Go)",
  "scripts": {
    "dev": "concurrently -n GO,WEB -c green,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "go run ./cmd/server",
    "dev:web": "vite",
    "seed": "go run ./cmd/seed",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}

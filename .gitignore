# Local Pi runtime state
.atl/

# Rust build artifacts
target/
.run/
.env
# Anchored on purpose. Unlike Docker, git matches ignore patterns at any
# depth, so a bare "data/" also hides frontend/js/data/: a new module dropped
# there never shows in git status and never gets committed. This is a real
# defect, but a separate one: the modules lost in the blank-page incident were
# all committed and tracked.
/data/
/production-data/
secrets/*
!secrets/.gitkeep

# Python bytecode
__pycache__/
*.pyc

# Node test dependencies (pnpm)
node_modules/

# Playwright test artifacts
test-results/
playwright-report/

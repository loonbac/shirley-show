# Local Pi runtime state
.atl/

# Rust build artifacts
target/
.run/
.env
# Anchored on purpose: a bare "data/" or "production-data/" also matches a
# nested path such as frontend/js/data/, so a new module dropped there stays
# untracked and disappears from the next checkout.
/data/
/production-data/
secrets/*
!secrets/.gitkeep

# Python bytecode
__pycache__/
*.pyc

# Node test dependencies (pnpm)
node_modules/

# Playwright test artifacts
test-results/
playwright-report/

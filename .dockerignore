# Build artifacts
target/

# VCS
.git/
.gitignore

# Local runtime & secrets (NEVER in the image)
.env
.env.*
!.env.example
.run/
secrets/
*.pem
*id_ed25519*
*id_rsa*

# Runtime state and production data: the container gets a volume, never a copy.
# Anchored with a leading slash as a precaution. Docker already matches these
# patterns against the full path relative to the context root, so a bare "data/"
# only ever excluded the top-level directory and never frontend/js/data/. The
# anchoring costs nothing and removes the ambiguity for anyone reading this.
# It does NOT fix the blank-page incident: that came from tar, where an
# unanchored --exclude='data' matches any path segment.
/data/
/production-data/
/audio/
/posters/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal

# Local dev & SDD paperwork
atl/
.atl/
.pi/
odd/
openspec/
.codegraph/
tmp/
*.log
.DS_Store

# Build artifacts
target/

# VCS
.git/
.gitignore

# Local runtime & secrets (NEVER in the image)
.env
.env.*
!.env.example
.run/
secrets/
*.pem
*id_ed25519*
*id_rsa*

# Runtime state and production data: the container gets a volume, never a copy.
# Anchored with a leading slash on purpose: an unanchored "data/" also matches
# frontend/js/data/, and dropping that directory builds cleanly but serves a
# blank page. An anchored pattern only matches the repository root.
/data/
/production-data/
/audio/
/posters/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal

# Local dev & SDD paperwork
atl/
.atl/
.pi/
odd/
openspec/
.codegraph/
tmp/
*.log
.DS_Store

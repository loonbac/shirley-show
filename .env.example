# Shirley Show — variables de entorno.
# Copia a .env para desarrollo local (NO commitear el .env).
#
# Esta lista es la que el código lee de verdad (src/config.rs). Si añades una
# variable nueva, regístrala aquí, en compose.yaml y en docs/deployment-koro-panel.md.

# --- Proveedor de IA (Ressy) ---
# Proveedor principal: Command Code. Sin ninguna de las dos claves, la app
# funciona igual pero el asistente responde "no configurado".
CMD_API_KEY=
CMD_MODEL=stealth/space-bunny-alpha
CMD_BASE_URL=https://api.commandcode.ai/provider/v1
# Fallback opcional: Groq. Solo se usa si no hay CMD_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Servidor ---
# Dentro de un contenedor DEBE ser 0.0.0.0:<puerto>. Atado a 127.0.0.1 no es
# alcanzable desde el host y el proxy devuelve 502.
SHIRLEY_BIND=0.0.0.0:3100
SHIRLEY_DATA_DIR=.run/data
SHIRLEY_FRONTEND_DIR=frontend
# Base pública para el enlace del ticket que se envía por WhatsApp.
# Sin ella el enlace sale relativo (/#/ticket/<token>) y el comprador no puede abrirlo.
SHIRLEY_PUBLIC_BASE_URL=

# --- Herramientas externas ---
YT_DLP_BIN=yt-dlp
# VOCAL_SEP_BIN=            # separador local (si no se usa la PC remota)
# FFPROBE_BIN=ffprobe
# FFMPEG_BIN=ffmpeg

# --- Separación vocal (Google Colab) ---
# La GPU se enciende al iniciar una separación y se apaga al terminar la última.
# Requiere el binario colab-cli en PATH y un token OAuth con refresh_token.
SHIRLEY_COLAB_BIN=colab
SHIRLEY_COLAB_TOKEN=~/.config/colab/token.json
SHIRLEY_COLAB_GPU=g4
SHIRLEY_COLAB_OVERLAP=12
SHIRLEY_COLAB_TIMEOUT_SECS=1800
# Vacío = usa el directorio de trabajo de la app.
SHIRLEY_COLAB_WORK_DIR=

# --- PC de Joshua (RETIRADO) ---
# El backend SSH ya no se usa para separar. Se mantienen las variables para no
# romper configuraciones antiguas; no tienen efecto en la separación.
JOSHUA_PC_HOST=
JOSHUA_PC_USER=loonbac
JOSHUA_PC_SSH_KEY=/home/shirley/.ssh/id_ed25519
JOSHUA_PC_PORT=22
JOSHUA_PC_WAKE_TIMEOUT_MINS=10

# --- Timeouts ---
SHIRLEY_AGENT_TIMEOUT_SECS=120
SHIRLEY_SEPARATION_TIMEOUT_SECS=600
# Retirado: el timeout de Colab se configura con SHIRLEY_COLAB_TIMEOUT_SECS.
SHIRLEY_REMOTE_SEPARATION_TIMEOUT_SECS=1500

# Host del panel cuando la landing vive en el dominio raíz.
# Sin esta variable el despliegue sirve todo en un solo host, como antes.
# Con ella, el host publico solo entrega la landing: /api y /panel dan 404 alli,
# porque /api/agent/chat no tiene capa de autenticacion.
SHIRLEY_PANEL_BASE_URL=https://panel.shirleyshow.site

# Host del modo puerta. Con esto la puerta vive en su propio subdominio y solo
# alcanza lo que necesita: consultar su evento, vender entradas en la puerta y
# marcar ingresos. El chat, el repertorio y el resto de la API le responden 404.
# Va detras de su propia aplicacion de Cloudflare Access, con sesion larga para
# que no caduque a mitad del evento.
SHIRLEY_DOOR_BASE_URL=https://puerta.shirleyshow.site

# Token de API de Cloudflare para dar de alta los hosts del split (DNS, tunel
# y aplicaciones de Access). Es de cuenta, cubre akarui.site, loonbac-dev.moe y
# shirleyshow.site. NO es una variable del servidor: la aplicacion no lo lee, lo
# usa el operador desde su maquina. Por eso vive en .env (ignorado por git) y
# nunca en el entorno del contenedor.
# Permisos necesarios: Zone:DNS:Edit, Zone:Zone:Read, Account:Cloudflare Tunnel:Edit,
# Account:Access: Apps and Policies:Edit.
# Valores de ejemplo en docs/cloudflare-token.md (nunca el real).
CLOUDFLARE_API_TOKEN=

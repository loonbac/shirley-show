# Copia a .env y completa tus keys (NO commitear el .env)
# Proveedor principal: OpenCode Go (https://opencode.ai)
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash
# Fallback opcional: Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
SHIRLEY_BIND=0.0.0.0:3100
SHIRLEY_DATA_DIR=.run/data
SHIRLEY_FRONTEND_DIR=frontend

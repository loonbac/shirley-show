# Copia a .env y completa tu key de https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
SHIRLEY_BIND=0.0.0.0:3100
SHIRLEY_DATA_DIR=.run/data
SHIRLEY_FRONTEND_DIR=frontend

# Ruta al ejecutable yt-dlp (opcional si está en PATH)
# YT_DLP_BIN=/home/loonbac/.nix-profile/bin/yt-dlp

# Timeout global en segundos para solicitudes del asistente (por defecto: 120)
# SHIRLEY_AGENT_TIMEOUT_SECS=120

# Copia este archivo a .env y ajusta los valores.

# Puerto del servidor Go (sirve API + frontend compilado).
PORT=3001

# Interfaz donde escuchar. Vacío = todas (Docker). Para túnel manual en el mismo
# host, usa 127.0.0.1 para que la app SOLO sea accesible a través de Cloudflare.
BIND_ADDR=

# Secreto para firmar los tokens de sesión (JWT). Cámbialo por algo único.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Credenciales de la administradora que se crean al ejecutar el seed.
ADMIN_USUARIO=shirleyshow
ADMIN_PASSWORD=manuelitope123

# Rutas de datos (SQLite). En Docker se montan como volumen.
DB_PATH=data/eventos.db
WA_STORE_PATH=data/whatsapp.db

# Carpeta del frontend compilado (en producción/Docker es "dist").
WEB_DIR=dist

# WhatsApp directo (whatsmeow). "true" para activarlo; requiere emparejar escaneando un QR.
WHATSAPP_ON=false
